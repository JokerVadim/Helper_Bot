# Telegram bot
BOT_TOKEN=your_telegram_bot_token

# Tavily search
TAVILY_KEY=tvly-your-tavily-api-key

# Groq AI
GROQ_KEY=gsk_your-groq-api-key

# Fallback AI (Cerebras / SambaNova / GitHub Models — OpenAI-совместимые)
# Получить ключ: https://inference.cerebras.ai/
FALLBACK_KEY=your-fallback-api-key
# По умолчанию Cerebras, можно заменить:
# SambaNova: https://api.sambanova.ai/v1
# GitHub Models: https://models.inference.ai.azure.com
FALLBACK_URL=https://api.cerebras.ai/v1
# Модель (зависит от провайдера):
# Cerebras: llama3.1-8b
# SambaNova: Meta-Llama-3.3-70B-Instruct
# GitHub: gpt-4o-mini
FALLBACK_MODEL=llama3.1-8b
